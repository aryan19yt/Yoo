function PublicSoundImage({
  sound,
}: {
  sound: SoundboardSound;
}) {
  const [imageUrl, setImageUrl] =
    useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function loadImage() {
      if (!sound.image_path) return;

      const { data, error } =
        await supabase.storage
          .from("soundboard-images")
          .createSignedUrl(
            sound.image_path,
            3600
          );

      if (
        !cancelled &&
        !error &&
        data?.signedUrl
      ) {
        setImageUrl(data.signedUrl);
      }
    }

    loadImage();

    return () => {
      cancelled = true;
    };
  }, [
    sound.id,
    sound.image_path,
  ]);

  if (!imageUrl) {
    return (
      <div className="flex h-full w-full items-center justify-center bg-[#111827] text-[7px] font-black uppercase tracking-wider text-[#475569]">
        No Image
      </div>
    );
  }

  return (
    <img
      src={imageUrl}
      alt={sound.name}
      className="h-full w-full object-cover"
    />
  );
}


export default function CreatorPage() {

