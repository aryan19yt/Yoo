        "Record or upload audio and play it live on stream.",

    },

    soundboard: {

      title: "Soundboard",

      mobile: "Soundboard",

      description:

        "Play funny or custom sounds on the creator's stream.",

    },

    stickers: {

      title: "Stickers",

      mobile: "Stickers",

      description:

        "Send custom stickers and images on stream.",

    },

    spin_wheel: {

      title: "Spin the Wheel",

      mobile: "Wheel",

      description:

        "Try your luck and trigger fun challenges.",

    },

    tasks: {

      title: "Tasks",

      mobile: "Tasks",

