# ==============================================================================
# StreamLounge Environment Configuration Template
# ==============================================================================
# Duplicate this file as .env.local for local development.
# In production (e.g. Vercel, AWS, Docker), configure these in your provider dashboard.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL
# ------------------------------------------------------------------------------
# Public base URL of the application. Used for OAuth redirects and canonical links.
# Local Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Required for both local development and production.
# Located in: Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Required for viewer interactions, checkout, and webhook verification.
# Located in: Razorpay Dashboard -> Settings -> API Keys & Webhooks
#
# Key ID (used server-side to generate orders and sent to client at checkout):
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Key Secret (SERVER-ONLY - NEVER EXPOSE TO CLIENT):
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook Secret (SERVER-ONLY):
# Configure webhook URL in Razorpay Dashboard -> Webhooks:
# URL: https://yourdomain.com/api/payments/webhook
# Active events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SIGNING SECRETS (Optional / Recommended)
# ------------------------------------------------------------------------------
# Dedicated server-only secrets for HMAC signing overlay tokens and payment verification tokens.
# If omitted, system safely falls back to RAZORPAY_KEY_SECRET with domain separation.
# OVERLAY_SIGNING_SECRET=your_long_random_hex_or_string_secret
# PAYMENT_SIGNING_SECRET=your_long_random_hex_or_string_secret

# ------------------------------------------------------------------------------
# 5. GOOGLE / YOUTUBE OAUTH (Optional for core payments, required for YouTube sync)
# ------------------------------------------------------------------------------
# Located in: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI:
#   Local: http://localhost:3000/api/auth/youtube/callback
#   Production: https://yourdomain.com/api/auth/youtube/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 6. OPENAI (Optional for core payments, required for AI Stickers and TTS)
# ------------------------------------------------------------------------------
# Used in /api/stickers/generate (DALL-E) and /api/tts (Audio Speech)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
